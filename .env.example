# ===== Обязательное =====

# Apify — сбор роликов. console.apify.com → Settings → API & Integrations
APIFY_TOKEN=
# Postmypost — публикация. app.postmypost.io → Access Tokens → Create
POSTMYPOST_TOKEN=
# ID проекта в Postmypost. Узнать: python main.py accounts
POSTMYPOST_PROJECT_ID=
# Telegram-бот. Создать у @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Кому бот подчиняется (ID через запятую). Узнать: напиши своему боту /start — он пришлёт твой ID
TELEGRAM_ADMIN_IDS=

# ===== Желательное =====

# Claude — лёгкий рерайт подписей. console.anthropic.com → API Keys. Без ключа подпись берётся из оригинала (очищенная)
ANTHROPIC_API_KEY=
# CAPTION_MODEL=claude-haiku-4-5

# ===== Тонкая настройка (значения по умолчанию) =====

# Сколько роликов забирать с аккаунта: первый сбор (весь архив) и обычная проверка.
# Для первой пробы поставь APIFY_ARCHIVE_LIMIT=5 — это ~$0.02
# APIFY_ARCHIVE_LIMIT=1000
# APIFY_INCREMENTAL_LIMIT=30
# Платная копия видео у Apify ($0.02 за МБ) — обычно не нужна
# APIFY_DOWNLOADED_VIDEO=0

# TIMEZONE=Europe/Moscow
# Слоты новых аккаунтов по умолчанию (меняются в боте: /slots)
# DEFAULT_SLOTS=10:00,15:00,20:00
# На сколько дней вперёд планировать и ставить в Postmypost
# PLAN_DAYS=2
# Случайный сдвиг времени публикации, ± минут
# JITTER_MIN=15
# Один ролик в разных аккаунтах — не ближе, минут
# MIN_GAP_SAME_VIDEO_MIN=120

# Уникализация: сила (light|medium|strong), порог похожести на оригинал, кодировщик (h264_nvenc — видеокарта NVIDIA)
# UNIQ_INTENSITY=medium
# UNIQ_MAX_SIMILARITY=0.9
# UNIQ_ENCODER=

# Как часто проверять новые ролики и статусы публикаций, минут; время ежедневной сводки
# INGEST_EVERY_MIN=60
# SYNC_EVERY_MIN=15
# SUMMARY_TIME=21:00
# Предупреждать, если роликов в запасе меньше чем на N дней
# QUEUE_LOW_DAYS=3

# Папка для базы, видео и логов (по умолчанию ./data)
# DATA_DIR=
