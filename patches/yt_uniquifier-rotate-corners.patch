@@ -2,6 +2,7 @@
 
 from __future__ import annotations
 
+import math
 import random
 import re
 
@@ -102,9 +103,14 @@ def _build_rotate(params: BaseModel, alloc: LabelAllocator, in_lbl: str) -> Filt
     params = ensure_params(params, RotateParams)
     out = alloc.next("v")
     # Default to SDR fill; pipeline rewrites filter_str for HDR (see FilterGraph).
+    # Zoom just enough that the rotated frame covers the whole canvas, so the
+    # fill-colour corner wedges never reach the output (was: crop=iw:ih only).
+    a = abs(math.radians(params.degrees))
+    zoom = f"({math.cos(a):.6f}+max(iw\\,ih)/min(iw\\,ih)*{math.sin(a):.6f})"
     filt = (
         f"rotate={params.degrees}*PI/180:fillcolor={params.fillcolor_sdr},"
-        "crop=iw:ih"
+        f"scale=trunc(iw*{zoom}/2)*2:trunc(ih*{zoom}/2)*2:flags=lanczos,"
+        f"crop=trunc(iw/{zoom}/2)*2:trunc(ih/{zoom}/2)*2,setsar=1"
     )
     return FilterChain(in_label=in_lbl, out_label=out, filter_str=filt)
 
